NODE_ENV=development
PORT=3000

# mysql://USER:PASSWORD@HOST:PORT/DATABASE  (URL-encode special characters, e.g. @ → %40)
DATABASE_URL="mysql://root:your_db_password@localhost:3306/personal_gym_db"

# Use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# The single account created by `npm run seed`
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change_me
ADMIN_NAME=Admin

UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:3000
MAX_UPLOAD_MB=15
MAX_VIDEO_UPLOAD_MB=100

# The seed (run on every deploy) creates the admin account and the built-in
# library: exercises, categories, goal types and foods. Set to true only if you
# also want sample workouts, logs and photos added to empty tables.
SEED_DEMO_DATA=false
