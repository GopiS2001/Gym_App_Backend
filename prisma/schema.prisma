// Personal Gym & Fitness Tracker - Prisma Schema
// Database: personal_gym_db (MySQL 8)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- ENUMS

enum Role {
  ADMIN
  OWNER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ATHLETE
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  ABANDONED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
  DRAFT
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SessionStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum SessionExerciseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum PhotoType {
  FRONT
  SIDE
  BACK
  OTHER
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACKS
  PRE_WORKOUT
  POST_WORKOUT
  BEFORE_BED
}

enum ReminderType {
  PRE_WORKOUT
  BREAKFAST
  POST_WORKOUT
  LUNCH
  SNACK
  DINNER
  BEFORE_BED
  WATER
  CUSTOM
}

enum ReminderWorkoutLink {
  NONE
  BEFORE
  AFTER
}

enum SleepQuality {
  POOR
  FAIR
  GOOD
  EXCELLENT
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum WeightUnit {
  KG
  LB
}

enum HeightUnit {
  CM
  FT
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
}

// ---------------------------------------------------------------- CORE

model User {
  id           String    @id @default(uuid()) @db.Char(36)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(ADMIN)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  profile          Profile?
  settings         UserSetting?
  goals            FitnessGoal[]
  goalTypes        GoalType[]
  exercises        Exercise[]
  categories       WorkoutCategory[]
  workoutPlans     WorkoutPlan[]
  workoutSessions  WorkoutSession[]
  weightLogs       WeightLog[]
  bodyMeasurements BodyMeasurement[]
  progressPhotos   ProgressPhoto[]
  foodLogs         FoodLog[]
  foods            Food[]
  mealReminders    MealReminder[]
  waterLogs        WaterLog[]
  sleepLogs        SleepLog[]
  attendance       GymAttendance[]
  mediaAssets      MediaAsset[]
  refreshTokens    RefreshToken[]
  favourites       ExerciseFavourite[]
  warmups          Warmup[]
  songs            Song[]

  @@index([email])
  @@map("users")
}

model Profile {
  id              String          @id @default(uuid()) @db.Char(36)
  userId          String          @unique @map("user_id") @db.Char(36)
  fullName        String          @map("full_name") @db.VarChar(100)
  dateOfBirth     DateTime?       @map("date_of_birth") @db.Date
  gender          Gender          @default(UNSPECIFIED)
  heightCm        Decimal?        @map("height_cm") @db.Decimal(5, 2)
  currentWeightKg Decimal?        @map("current_weight_kg") @db.Decimal(6, 2)
  gymJoiningDate  DateTime?       @map("gym_joining_date") @db.Date
  experienceLevel ExperienceLevel @default(BEGINNER) @map("experience_level")
  profileImageUrl String?         @map("profile_image_url") @db.Text
  phone           String?         @db.VarChar(30)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model UserSetting {
  id                     String          @id @default(uuid()) @db.Char(36)
  userId                 String          @unique @map("user_id") @db.Char(36)
  theme                  ThemePreference @default(SYSTEM)
  weightUnit             WeightUnit      @default(KG) @map("weight_unit")
  heightUnit             HeightUnit      @default(CM) @map("height_unit")
  dailyWaterTargetMl     Int             @default(3000) @map("daily_water_target_ml")
  dailyCalorieTarget     Int             @default(2000) @map("daily_calorie_target")
  dailyProteinTargetG    Int             @default(150) @map("daily_protein_target_g")
  dailyCarbsTargetG      Int             @default(220) @map("daily_carbs_target_g")
  dailyFatTargetG        Int             @default(65) @map("daily_fat_target_g")
  weeklyWorkoutTarget    Int             @default(5) @map("weekly_workout_target")
  defaultRestSeconds     Int             @default(60) @map("default_rest_seconds")
  notificationEnabled    Boolean         @default(true) @map("notification_enabled")
  workoutReminderEnabled Boolean         @default(true) @map("workout_reminder_enabled")
  waterReminderEnabled   Boolean         @default(true) @map("water_reminder_enabled")
  /// Workout schedule used by pre/post-workout reminders. Time is local
  /// "HH:mm"; days is an array of WeekDay names, or null to use the days of
  /// the active workout plan (every day if there is none).
  workoutTime            String?         @map("workout_time") @db.VarChar(5)
  workoutDays            Json?           @map("workout_days")
  workoutDurationMin     Int             @default(60) @map("workout_duration_min")
  preWorkoutLeadMin      Int             @default(60) @map("pre_workout_lead_min")
  postWorkoutDelayMin    Int             @default(30) @map("post_workout_delay_min")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ---------------------------------------------------------------- GOALS

model GoalType {
  id           String   @id @default(uuid()) @db.Char(36)
  userId       String?  @map("user_id") @db.Char(36)
  name         String   @db.VarChar(80)
  slug         String   @unique @db.VarChar(80)
  description  String?  @db.Text
  iconName     String?  @map("icon_name") @db.VarChar(60)
  colorHex     String?  @map("color_hex") @db.VarChar(9)
  displayOrder Int      @default(0) @map("display_order")
  isCustom     Boolean  @default(false) @map("is_custom")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals FitnessGoal[]

  @@index([displayOrder])
  @@map("goal_types")
}

model FitnessGoal {
  id                      String     @id @default(uuid()) @db.Char(36)
  userId                  String     @map("user_id") @db.Char(36)
  goalTypeId              String     @map("goal_type_id") @db.Char(36)
  title                   String?    @db.VarChar(120)
  startingWeightKg        Decimal?   @map("starting_weight_kg") @db.Decimal(6, 2)
  targetWeightKg          Decimal?   @map("target_weight_kg") @db.Decimal(6, 2)
  targetBodyFatPercentage Decimal?   @map("target_body_fat_percentage") @db.Decimal(5, 2)
  startDate               DateTime   @map("start_date") @db.Date
  targetDate              DateTime?  @map("target_date") @db.Date
  status                  GoalStatus @default(ACTIVE)
  notes                   String?    @db.Text
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalType GoalType @relation(fields: [goalTypeId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([goalTypeId])
  @@map("fitness_goals")
}

// ---------------------------------------------------------------- EXERCISES

model WorkoutCategory {
  id           String   @id @default(uuid()) @db.Char(36)
  userId       String?  @map("user_id") @db.Char(36)
  name         String   @db.VarChar(80)
  slug         String   @unique @db.VarChar(80)
  description  String?  @db.Text
  imageUrl     String?  @map("image_url") @db.Text
  iconName     String?  @map("icon_name") @db.VarChar(60)
  colorHex     String?  @map("color_hex") @db.VarChar(9)
  displayOrder Int      @default(0) @map("display_order")
  isCustom     Boolean  @default(false) @map("is_custom")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises Exercise[]
  warmups   Warmup[]

  @@index([displayOrder])
  @@map("workout_categories")
}

model Exercise {
  id               String          @id @default(uuid()) @db.Char(36)
  userId           String?         @map("user_id") @db.Char(36)
  categoryId       String          @map("category_id") @db.Char(36)
  name             String          @db.VarChar(140)
  description      String?         @db.Text
  instructions     String?         @db.Text
  targetMuscle     String?         @map("target_muscle") @db.VarChar(120)
  secondaryMuscles Json?           @map("secondary_muscles")
  equipment        String?         @db.VarChar(120)
  difficultyLevel  DifficultyLevel @default(BEGINNER) @map("difficulty_level")
  /// Cover image; always the first entry of `imageUrls` when that is set.
  imageUrl         String?         @map("image_url") @db.Text
  /// Gallery of image URLs, in display order.
  imageUrls        Json?           @map("image_urls")
  /// Banner behind the exercise title; independent of the gallery.
  backgroundImageUrl String?       @map("background_image_url") @db.Text
  /// A link (YouTube etc.) or the URL of an uploaded video file.
  videoUrl         String?         @map("video_url") @db.Text
  caloriesPerMin   Decimal?        @map("calories_per_min") @db.Decimal(5, 2)
  isCustom         Boolean         @default(false) @map("is_custom")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  user             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         WorkoutCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  planExercises    WorkoutPlanExercise[]
  sessionExercises SessionExercise[]
  favourites       ExerciseFavourite[]

  @@index([categoryId])
  @@index([name])
  @@index([difficultyLevel])
  @@map("exercises")
}

/// A warm-up drill done before training. The category is optional: a
/// warm-up with none is a general one that suits any session.
model Warmup {
  id              String   @id @default(uuid()) @db.Char(36)
  userId          String   @map("user_id") @db.Char(36)
  categoryId      String?  @map("category_id") @db.Char(36)
  name            String   @db.VarChar(140)
  durationSeconds Int?     @map("duration_seconds")
  reps            Int?
  description     String?  @db.Text
  /// Cover image; always the first entry of `imageUrls` when that is set.
  imageUrl           String? @map("image_url") @db.Text
  imageUrls          Json?   @map("image_urls")
  backgroundImageUrl String? @map("background_image_url") @db.Text
  /// A link (YouTube etc.) or the URL of an uploaded video file.
  videoUrl           String? @map("video_url") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category WorkoutCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, categoryId])
  @@map("warmups")
}

model ExerciseFavourite {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  exerciseId String   @map("exercise_id") @db.Char(36)
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@map("exercise_favourites")
}

// ---------------------------------------------------------------- PLANS

model WorkoutPlan {
  id              String          @id @default(uuid()) @db.Char(36)
  userId          String          @map("user_id") @db.Char(36)
  planName        String          @map("plan_name") @db.VarChar(140)
  description     String?         @db.Text
  coverImageUrl   String?         @map("cover_image_url") @db.Text
  startDate       DateTime?       @map("start_date") @db.Date
  endDate         DateTime?       @map("end_date") @db.Date
  status          PlanStatus      @default(ACTIVE)
  difficultyLevel DifficultyLevel @default(BEGINNER) @map("difficulty_level")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises WorkoutPlanExercise[]
  sessions  WorkoutSession[]

  @@index([userId, status])
  @@map("workout_plans")
}

model WorkoutPlanExercise {
  id             String   @id @default(uuid()) @db.Char(36)
  workoutPlanId  String   @map("workout_plan_id") @db.Char(36)
  exerciseId     String   @map("exercise_id") @db.Char(36)
  scheduledDay   WeekDay  @map("scheduled_day")
  displayOrder   Int      @default(0) @map("display_order")
  targetSets     Int      @default(3) @map("target_sets")
  targetReps     Int      @default(12) @map("target_reps")
  targetWeightKg Decimal? @map("target_weight_kg") @db.Decimal(6, 2)
  restSeconds    Int      @default(60) @map("rest_seconds")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  plan     WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercise Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([workoutPlanId, scheduledDay])
  @@map("workout_plan_exercises")
}

// ---------------------------------------------------------------- SESSIONS

model WorkoutSession {
  id              String        @id @default(uuid()) @db.Char(36)
  userId          String        @map("user_id") @db.Char(36)
  workoutPlanId   String?       @map("workout_plan_id") @db.Char(36)
  title           String?       @db.VarChar(160)
  sessionDate     DateTime      @map("session_date") @db.Date
  startedAt       DateTime      @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  durationSeconds Int           @default(0) @map("duration_seconds")
  totalVolumeKg   Decimal       @default(0) @map("total_volume_kg") @db.Decimal(10, 2)
  caloriesBurned  Int           @default(0) @map("calories_burned")
  status          SessionStatus @default(IN_PROGRESS)
  notes           String?       @db.Text
  clientOpId      String?       @unique @map("client_op_id") @db.VarChar(80)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      WorkoutPlan?      @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)
  exercises SessionExercise[]

  @@index([userId, sessionDate])
  @@index([userId, status])
  @@map("workout_sessions")
}

model SessionExercise {
  id               String                @id @default(uuid()) @db.Char(36)
  workoutSessionId String                @map("workout_session_id") @db.Char(36)
  exerciseId       String                @map("exercise_id") @db.Char(36)
  displayOrder     Int                   @default(0) @map("display_order")
  targetSets       Int                   @default(3) @map("target_sets")
  targetReps       Int                   @default(12) @map("target_reps")
  restSeconds      Int                   @default(60) @map("rest_seconds")
  status           SessionExerciseStatus @default(PENDING)
  notes            String?               @db.Text
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  session  WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets     SessionSet[]

  @@index([workoutSessionId])
  @@map("session_exercises")
}

model SessionSet {
  id                String   @id @default(uuid()) @db.Char(36)
  sessionExerciseId String   @map("session_exercise_id") @db.Char(36)
  setNumber         Int      @map("set_number")
  reps              Int      @default(0)
  weightKg          Decimal  @default(0) @map("weight_kg") @db.Decimal(6, 2)
  completed         Boolean  @default(false)
  restSeconds       Int      @default(0) @map("rest_seconds")
  notes             String?  @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId])
  @@map("session_sets")
}

// ---------------------------------------------------------------- PROGRESS

model WeightLog {
  id           String   @id @default(uuid()) @db.Char(36)
  userId       String   @map("user_id") @db.Char(36)
  weightKg     Decimal  @map("weight_kg") @db.Decimal(6, 2)
  recordedDate DateTime @map("recorded_date") @db.Date
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recordedDate])
  @@index([userId, recordedDate])
  @@map("weight_logs")
}

model BodyMeasurement {
  id                String   @id @default(uuid()) @db.Char(36)
  userId            String   @map("user_id") @db.Char(36)
  recordedDate      DateTime @map("recorded_date") @db.Date
  chestCm           Decimal? @map("chest_cm") @db.Decimal(5, 2)
  waistCm           Decimal? @map("waist_cm") @db.Decimal(5, 2)
  hipsCm            Decimal? @map("hips_cm") @db.Decimal(5, 2)
  leftArmCm         Decimal? @map("left_arm_cm") @db.Decimal(5, 2)
  rightArmCm        Decimal? @map("right_arm_cm") @db.Decimal(5, 2)
  leftThighCm       Decimal? @map("left_thigh_cm") @db.Decimal(5, 2)
  rightThighCm      Decimal? @map("right_thigh_cm") @db.Decimal(5, 2)
  leftCalfCm        Decimal? @map("left_calf_cm") @db.Decimal(5, 2)
  rightCalfCm       Decimal? @map("right_calf_cm") @db.Decimal(5, 2)
  neckCm            Decimal? @map("neck_cm") @db.Decimal(5, 2)
  shouldersCm       Decimal? @map("shoulders_cm") @db.Decimal(5, 2)
  bodyFatPercentage Decimal? @map("body_fat_percentage") @db.Decimal(5, 2)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, recordedDate])
  @@index([userId, recordedDate])
  @@map("body_measurements")
}

model ProgressPhoto {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  mediaAssetId String?   @map("media_asset_id") @db.Char(36)
  photoUrl     String    @map("photo_url") @db.Text
  photoType    PhotoType @default(FRONT) @map("photo_type")
  capturedDate DateTime  @map("captured_date") @db.Date
  weightKg     Decimal?  @map("weight_kg") @db.Decimal(6, 2)
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([userId, capturedDate])
  @@map("progress_photos")
}

// ---------------------------------------------------------------- LIFESTYLE

/// Food Library: the master catalogue. Nutrition values are per
/// `servingSize` × `servingUnit` (e.g. 100 g, or 1 piece). Rows with no
/// userId are the built-in library; the rest were added in the app.
model Food {
  id          String   @id @default(uuid()) @db.Char(36)
  userId      String?  @map("user_id") @db.Char(36)
  name        String   @db.VarChar(160)
  category    String?  @db.VarChar(60)
  servingSize Decimal  @default(1) @map("serving_size") @db.Decimal(8, 2)
  servingUnit String   @default("serving") @map("serving_unit") @db.VarChar(40)
  calories    Decimal  @default(0) @db.Decimal(8, 2)
  proteinG    Decimal  @default(0) @map("protein_g") @db.Decimal(8, 2)
  carbsG      Decimal  @default(0) @map("carbs_g") @db.Decimal(8, 2)
  fatG        Decimal  @default(0) @map("fat_g") @db.Decimal(8, 2)
  fibreG      Decimal? @map("fibre_g") @db.Decimal(8, 2)
  imageUrl    String?  @map("image_url") @db.Text
  isCustom    Boolean  @default(false) @map("is_custom")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodLogs FoodLog[]

  @@index([name])
  @@index([category])
  @@map("foods")
}

/// One food eaten: a Food Intake item. Name, unit and nutrition are a
/// snapshot taken when logged, so editing the Food Library later never
/// changes past entries. Entries for one date + meal type form that meal.
model FoodLog {
  id           String   @id @default(uuid()) @db.Char(36)
  userId       String   @map("user_id") @db.Char(36)
  foodId       String?  @map("food_id") @db.Char(36)
  foodName     String   @map("food_name") @db.VarChar(160)
  mealType     MealType @map("meal_type")
  quantity     Decimal  @default(1) @db.Decimal(8, 2)
  quantityUnit String   @default("serving") @map("quantity_unit") @db.VarChar(40)
  calories     Decimal  @default(0) @db.Decimal(8, 2)
  proteinG     Decimal  @default(0) @map("protein_g") @db.Decimal(8, 2)
  carbsG       Decimal  @default(0) @map("carbs_g") @db.Decimal(8, 2)
  fatG         Decimal  @default(0) @map("fat_g") @db.Decimal(8, 2)
  imageUrl     String?  @map("image_url") @db.Text
  consumedAt   DateTime @map("consumed_at")
  loggedDate   DateTime @map("logged_date") @db.Date
  notes        String?  @db.Text
  clientOpId   String?  @unique @map("client_op_id") @db.VarChar(80)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([userId, loggedDate])
  @@index([userId, mealType])
  @@index([foodId])
  @@map("food_logs")
}

/// A scheduled meal / water / workout-nutrition reminder. Notifications are
/// scheduled on the phone; this row is the source of truth they are rebuilt
/// from. When `workoutLink` is BEFORE or AFTER, the time and days come from
/// the workout schedule in user_settings instead of `reminderTime`/`repeatDays`.
model MealReminder {
  id            String              @id @default(uuid()) @db.Char(36)
  userId        String              @map("user_id") @db.Char(36)
  title         String              @db.VarChar(80)
  reminderType  ReminderType        @map("reminder_type")
  /// Local wall-clock time, "HH:mm".
  reminderTime  String              @map("reminder_time") @db.VarChar(5)
  /// Array of WeekDay names; empty means every day.
  repeatDays    Json                @map("repeat_days")
  message       String?             @db.Text
  isEnabled     Boolean             @default(true) @map("is_enabled")
  workoutLink   ReminderWorkoutLink @default(NONE) @map("workout_link")
  snoozeMinutes Int                 @default(10) @map("snooze_minutes")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("meal_reminders")
}

model WaterLog {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  amountMl   Int      @map("amount_ml")
  recordedAt DateTime @map("recorded_at")
  loggedDate DateTime @map("logged_date") @db.Date
  clientOpId String?  @unique @map("client_op_id") @db.VarChar(80)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedDate])
  @@map("water_logs")
}

model SleepLog {
  id              String        @id @default(uuid()) @db.Char(36)
  userId          String        @map("user_id") @db.Char(36)
  sleepStart      DateTime      @map("sleep_start")
  sleepEnd        DateTime      @map("sleep_end")
  durationMinutes Int           @map("duration_minutes")
  sleepQuality    SleepQuality? @map("sleep_quality")
  loggedDate      DateTime      @map("logged_date") @db.Date
  notes           String?       @db.Text
  clientOpId      String?       @unique @map("client_op_id") @db.VarChar(80)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedDate])
  @@map("sleep_logs")
}

model GymAttendance {
  id              String    @id @default(uuid()) @db.Char(36)
  userId          String    @map("user_id") @db.Char(36)
  attendanceDate  DateTime  @map("attendance_date") @db.Date
  checkInAt       DateTime  @map("check_in_at")
  checkOutAt      DateTime? @map("check_out_at")
  durationMinutes Int       @default(0) @map("duration_minutes")
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, attendanceDate])
  @@index([userId, attendanceDate])
  @@map("gym_attendance")
}

// ---------------------------------------------------------------- MUSIC

/// A song in the user's workout music list: the film it comes from, its name
/// a cover picture and the uploaded audio file the player streams.
model Song {
  id         String   @id @default(uuid()) @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  movieTitle String   @map("movie_title") @db.VarChar(160)
  songName   String   @map("song_name") @db.VarChar(160)
  imageUrl   String?  @map("image_url") @db.Text
  audioUrl   String?  @map("audio_url") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, movieTitle])
  @@map("songs")
}

// ---------------------------------------------------------------- MEDIA

model MediaAsset {
  id              String    @id @default(uuid()) @db.Char(36)
  userId          String    @map("user_id") @db.Char(36)
  mediaType       MediaType @map("media_type")
  storageProvider String    @default("local") @map("storage_provider") @db.VarChar(40)
  storageKey      String    @map("storage_key") @db.VarChar(255)
  mediaUrl        String    @map("media_url") @db.Text
  fileSize        Int       @default(0) @map("file_size")
  mimeType        String    @map("mime_type") @db.VarChar(120)
  originalName    String?   @map("original_name") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  progressPhotos ProgressPhoto[]

  @@index([userId, mediaType])
  @@map("media_assets")
}
